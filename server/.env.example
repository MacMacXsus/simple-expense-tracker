# example .env file for the server folder
# create file ".env" in the server folder and copy the content of this file to it
# your sensitive keys and configuration should go to ".env"
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_here
NODE_ENV=development
DATABASE_URL="mysql://johndoe:randompassword@localhost:3306/mydb"


BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@example.com